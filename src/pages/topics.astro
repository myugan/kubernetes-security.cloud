---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPublishedTopics } from '../utils/published-topics';
import StanceBadge from '../components/StanceBadge.astro';
import TacticIcon from '../components/TacticIcon.astro';
import TypeDot from '../components/TypeDot.astro';
import CategoryIcon from '../components/CategoryIcon.astro';
import { formatTopicDate, getRecentTopics } from '../utils/recent-topics';
import { formatPhase, formatPhaseUpper } from '../lib/taxonomy';

const topics = await getPublishedTopics();
const sortedTopics = topics.sort((a, b) => a.data.title.localeCompare(b.data.title));
const recentTopics = getRecentTopics(topics, 5);

const availableCategories = [...new Set(topics.map((t) => t.data.category))].sort();
const totalTopics = sortedTopics.length;
const mitreMappedTopicsCount = topics.filter(
  (topic) => Array.isArray(topic.data.mitreTechniques) && topic.data.mitreTechniques.length > 0
).length;
const offensiveCount = topics.filter((topic) => topic.data.category.toLowerCase() === 'offensive').length;
const defensiveCount = topics.filter((topic) => topic.data.category.toLowerCase() === 'defensive').length;
const availableOffensivePhases = [
  ...new Set(
    topics
      .filter((topic) => topic.data.category === 'offensive' && (topic.data.phase ?? topic.data.offensiveType))
      .map((topic) => (topic.data.phase ?? topic.data.offensiveType) as string)
  ),
].sort();
---

<BaseLayout
  title="Topics - Kubernetes Security"
  description="Reference materials covering offensive and defensive Kubernetes security techniques, with impact and mitigation for each topic."
>
  <div class="border-b border-app-border">
    <div class="max-w-7xl mx-auto px-4 sm:px-7 lg:px-12 py-12 lg:py-14 grid gap-10 min-w-0 lg:grid-cols-[1fr_400px] lg:items-start">
      <div class="flex flex-col gap-4 min-w-0">
        <p class="ks-kicker ks-kicker-accent">Topics</p>
        <h1 class="ks-display">Topics</h1>
        <p class="ks-lede max-w-[min(54ch,calc(100vw-2rem))]">
          Reference materials covering offensive and defensive Kubernetes security techniques
        </p>
        <div class="ks-stat-grid mt-2 grid-cols-2 sm:grid-cols-4">
          <div class="ks-stat-cell">
            <span class="ks-stat-n">{totalTopics}</span>
            <span class="ks-stat-label">Total</span>
          </div>
          <div class="ks-stat-cell">
            <span class="ks-stat-n">{mitreMappedTopicsCount}</span>
            <span class="ks-stat-label">ATT&amp;CK mapped</span>
          </div>
          <div class="ks-stat-cell">
            <span class="ks-stat-n inline-flex items-center gap-1.5">
              <CategoryIcon category="offensive" class="h-4 w-4 text-offensive" />
              {offensiveCount}
            </span>
            <span class="ks-stat-label">Offensive</span>
          </div>
          <div class="ks-stat-cell">
            <span class="ks-stat-n inline-flex items-center gap-1.5">
              <CategoryIcon category="defensive" class="h-4 w-4 text-defensive" />
              {defensiveCount}
            </span>
            <span class="ks-stat-label">Defensive</span>
          </div>
        </div>
      </div>
      {recentTopics.length > 0 && (
        <div class="flex flex-col gap-2.5 min-w-0">
          <p class="ks-kicker">Latest topics</p>
          <div class="ks-card overflow-hidden">
            {recentTopics.map((topic) => (
              <a href={`/topics/${topic.slug}`} class="flex items-center gap-2.5 px-3.5 py-2.5 border-b border-app-border last:border-0 hover:bg-app-surface-muted/70">
                <TypeDot category={topic.data.category} size="sm" />
                <span class="text-[13px] font-medium leading-snug ds-text-primary min-w-0 truncate">{topic.data.title}</span>
                <time class="ml-auto font-mono text-[11px] ds-text-muted whitespace-nowrap hidden sm:block" datetime={topic.data.createdAt!.toISOString().slice(0, 10)}>
                  {formatTopicDate(topic.data.createdAt!)}
                </time>
              </a>
            ))}
          </div>
        </div>
      )}
    </div>
  </div>

  <div class="border-b border-app-border bg-app-surface-muted/45">
    <div class="max-w-7xl mx-auto px-4 sm:px-7 lg:px-12 ks-filter-bar">
      <label class="flex items-center gap-2 border border-app-border-strong rounded-[5px] px-3 py-2 w-full sm:w-[260px] max-w-full bg-app-surface">
        <span class="ks-search-glyph" aria-hidden="true"></span>
        <input
          id="search-input"
          type="search"
          name="q"
          autocomplete="off"
          placeholder="Search topics"
          class="flex-1 min-w-0 bg-transparent outline-none text-[13px] ds-text-primary placeholder:text-app-text-muted"
        />
      </label>

      <div class="flex gap-1.5 flex-wrap">
        {availableCategories.map((category) => (
          <button
            type="button"
            class="ks-facet tag-filter-btn"
            data-tag-type="category"
            data-tag-value={category}
            data-tag-label={category.charAt(0).toUpperCase() + category.slice(1)}
          >
            <TypeDot category={category} size="sm" />
            <span>{category.charAt(0).toUpperCase() + category.slice(1)}</span>
            <span class="font-mono text-[11px] opacity-70">
              {topics.filter((topic) => topic.data.category === category).length}
            </span>
          </button>
        ))}
      </div>

      {availableOffensivePhases.length > 0 && (
        <div id="phase-filters" class="flex items-center gap-1.5 flex-wrap" style="display: none">
          <span class="hidden sm:block w-px h-[22px] bg-app-border mx-1.5" aria-hidden="true"></span>
          {availableOffensivePhases.map((phase) => (
            <button
              type="button"
              class="ks-phase-chip tag-filter-btn"
              data-tag-type="phase"
              data-tag-value={phase}
              data-tag-label={formatPhase(phase)}
            >
              <TacticIcon phase={phase} class="h-3.5 w-3.5 text-offensive" />
              <span>{formatPhase(phase)}</span>
            </button>
          ))}
        </div>
      )}

      <div class="flex items-center gap-2.5 ml-auto">
        <p class="text-[12.5px] ds-text-muted" aria-live="polite">
          Showing <span id="results-count-inline">{totalTopics}</span> topics
        </p>
        <button type="button" id="reset-filters-btn" class="hidden text-[12.5px] ds-link">Reset</button>
        <div class="ks-view-toggle">
          <button type="button" id="view-grid" class="is-active" aria-pressed="true">Grid</button>
          <button type="button" id="view-list" aria-pressed="false">List</button>
        </div>
      </div>
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-7 lg:px-12 py-8 lg:py-11">
    <div id="topics-container" class="ks-topics-grid">
      {sortedTopics.map((topic) => {
        const phase = topic.data.phase ?? topic.data.offensiveType;
        const phaseSlug = typeof phase === 'string' ? phase : '';
        const phaseLabel = formatPhaseUpper(phase);
        return (
          <a
            href={`/topics/${topic.slug}`}
            class="topic-card ks-card p-4 flex flex-col gap-2.5 hover:border-app-border-strong"
            data-category={topic.data.category}
            data-phase={phaseSlug}
            data-title={topic.data.title.toLowerCase()}
            data-description={topic.data.description.toLowerCase()}
          >
            <div class="flex items-center gap-2">
              <StanceBadge stance={topic.data.category} />
              {topic.data.category === 'offensive' && phaseLabel && (
                <span class="inline-flex items-center gap-1.5">
                  <TacticIcon phase={phase} class="h-3.5 w-3.5 text-offensive" />
                  <span class="font-mono text-[10px] tracking-wider ds-text-muted uppercase">{phaseLabel}</span>
                </span>
              )}
            </div>
            <span class="text-[14.5px] font-semibold leading-snug tracking-tight ds-text-primary">{topic.data.title}</span>
            <span class="text-[12.5px] leading-snug ds-text-muted line-clamp-3">{topic.data.description}</span>
          </a>
        );
      })}
    </div>

    <div id="no-results" class="hidden ks-card text-center py-10 px-4">
      <p class="ds-text-primary font-medium">No topics found matching your filters.</p>
      <p class="mt-1 text-sm ds-text-muted">Try another keyword, or clear filters to see everything again.</p>
      <button type="button" id="no-results-reset-btn" class="mt-4 ds-link text-sm">Reset filters</button>
    </div>
  </div>

  <script>
    (function () {
      let searchInput: HTMLInputElement | null = null;
      let topicsContainer: HTMLElement | null = null;
      let noResults: HTMLElement | null = null;
      let topicCards: NodeListOf<Element> | null = null;
      let tagFilterButtons: NodeListOf<Element> | null = null;
      let viewGridBtn: HTMLButtonElement | null = null;
      let viewListBtn: HTMLButtonElement | null = null;
      let resultsCountInline: HTMLElement | null = null;
      let resetFiltersBtn: HTMLButtonElement | null = null;
      let noResultsResetBtn: HTMLButtonElement | null = null;
      let phaseFilters: HTMLElement | null = null;

      const activeFiltersSet = new Set<string>();

      function hasCategory(value: string) {
        return Array.from(activeFiltersSet).some((key) => key.startsWith(`category:${value}:`));
      }

      function syncPhaseFilters() {
        const show = hasCategory('offensive');
        if (phaseFilters) phaseFilters.style.display = show ? 'flex' : 'none';
        if (show) return;
        Array.from(activeFiltersSet)
          .filter((key) => key.startsWith('phase:'))
          .forEach((key) => activeFiltersSet.delete(key));
      }

      function parseFilterTagKey(tagKey: string): { type: string; value: string; label: string } | null {
        const firstColon = tagKey.indexOf(':');
        if (firstColon === -1) return null;
        const type = tagKey.slice(0, firstColon);
        const rest = tagKey.slice(firstColon + 1);
        const secondColon = rest.indexOf(':');
        if (secondColon === -1) return { type, value: rest, label: '' };
        return { type, value: rest.slice(0, secondColon), label: rest.slice(secondColon + 1) };
      }

      function updateResetButtonVisibility() {
        if (!resetFiltersBtn || !searchInput) return;
        const hasSearch = searchInput.value.trim().length > 0;
        resetFiltersBtn.classList.toggle('hidden', !(hasSearch || activeFiltersSet.size > 0));
      }

      function resetFilters() {
        if (searchInput) searchInput.value = '';
        activeFiltersSet.clear();
        updateTagButtons();
        performFilter();
      }

      function setGridView() {
        if (!topicsContainer) return;
        topicsContainer.classList.remove('ks-topics-list');
        topicsContainer.classList.add('ks-topics-grid');
        viewGridBtn?.classList.add('is-active');
        viewListBtn?.classList.remove('is-active');
        viewGridBtn?.setAttribute('aria-pressed', 'true');
        viewListBtn?.setAttribute('aria-pressed', 'false');
        localStorage.setItem('topics-view', 'grid');
      }

      function setListView() {
        if (!topicsContainer) return;
        topicsContainer.classList.remove('ks-topics-grid');
        topicsContainer.classList.add('ks-topics-list');
        viewListBtn?.classList.add('is-active');
        viewGridBtn?.classList.remove('is-active');
        viewListBtn?.setAttribute('aria-pressed', 'true');
        viewGridBtn?.setAttribute('aria-pressed', 'false');
        localStorage.setItem('topics-view', 'list');
      }

      function addFilter(type: string, value: string, label: string) {
        if (type === 'category') {
          Array.from(activeFiltersSet)
            .filter((key) => key.startsWith('category:'))
            .forEach((key) => activeFiltersSet.delete(key));
        }
        activeFiltersSet.add(`${type}:${value}:${label}`);
        updateTagButtons();
        performFilter();
      }

      function removeFilter(type: string, value: string) {
        const tagKey = Array.from(activeFiltersSet).find((key) => key.startsWith(`${type}:${value}:`));
        if (tagKey) activeFiltersSet.delete(tagKey);
        updateTagButtons();
        performFilter();
      }

      function updateTagButtons() {
        tagFilterButtons?.forEach((btn) => {
          const type = (btn as HTMLElement).dataset.tagType || '';
          const value = (btn as HTMLElement).dataset.tagValue || '';
          const active = Array.from(activeFiltersSet).some((key) => key.startsWith(`${type}:${value}:`));
          btn.classList.toggle('is-active', active);
        });
      }

      function performFilter() {
        if (!topicsContainer || !noResults || !topicCards || topicCards.length === 0) return;

        syncPhaseFilters();
        updateTagButtons();

        const searchQuery = searchInput?.value.toLowerCase().trim() || '';
        const activeCategories = new Set<string>();
        const activePhases = new Set<string>();

        activeFiltersSet.forEach((tagKey) => {
          const parsed = parseFilterTagKey(tagKey);
          if (!parsed) return;
          if (parsed.type === 'category') activeCategories.add(parsed.value);
          if (parsed.type === 'phase') activePhases.add(parsed.value);
        });

        let visibleCount = 0;
        topicCards.forEach((card) => {
          const cardElement = card as HTMLElement;
          const category = cardElement.dataset.category || '';
          const cardPhase = cardElement.dataset.phase || '';
          const title = cardElement.dataset.title || '';
          const description = cardElement.dataset.description || '';
          const matchesSearch = !searchQuery || title.includes(searchQuery) || description.includes(searchQuery);
          const matchesCategory = activeCategories.size === 0 || activeCategories.has(category);
          const matchesPhase =
            activePhases.size === 0 ||
            (category === 'offensive' && cardPhase.length > 0 && activePhases.has(cardPhase));

          if (matchesSearch && matchesCategory && matchesPhase) {
            cardElement.style.display = '';
            visibleCount++;
          } else {
            cardElement.style.display = 'none';
          }
        });

        topicsContainer.classList.toggle('hidden', visibleCount === 0);
        noResults.classList.toggle('hidden', visibleCount !== 0);
        if (resultsCountInline) resultsCountInline.textContent = String(visibleCount);
        updateResetButtonVisibility();
      }

      function initSearch() {
        searchInput = document.getElementById('search-input') as HTMLInputElement;
        topicsContainer = document.getElementById('topics-container');
        noResults = document.getElementById('no-results');
        topicCards = document.querySelectorAll('.topic-card');
        tagFilterButtons = document.querySelectorAll('.tag-filter-btn');
        viewGridBtn = document.getElementById('view-grid') as HTMLButtonElement;
        viewListBtn = document.getElementById('view-list') as HTMLButtonElement;
        resultsCountInline = document.getElementById('results-count-inline');
        resetFiltersBtn = document.getElementById('reset-filters-btn') as HTMLButtonElement;
        noResultsResetBtn = document.getElementById('no-results-reset-btn') as HTMLButtonElement;
        phaseFilters = document.getElementById('phase-filters');

        if (!searchInput || !topicsContainer || !noResults || !topicCards || topicCards.length === 0) {
          setTimeout(initSearch, 100);
          return;
        }

        searchInput.addEventListener('input', performFilter);
        tagFilterButtons.forEach((btn) => {
          btn.addEventListener('click', () => {
            const type = (btn as HTMLElement).dataset.tagType || '';
            const value = (btn as HTMLElement).dataset.tagValue || '';
            const label = (btn as HTMLElement).dataset.tagLabel || '';
            const tagKey = Array.from(activeFiltersSet).find((key) => key.startsWith(`${type}:${value}:`));
            if (tagKey) removeFilter(type, value);
            else addFilter(type, value, label);
          });
        });
        resetFiltersBtn?.addEventListener('click', resetFilters);
        noResultsResetBtn?.addEventListener('click', resetFilters);
        viewGridBtn?.addEventListener('click', setGridView);
        viewListBtn?.addEventListener('click', setListView);
        if (localStorage.getItem('topics-view') === 'list') setListView();
        applyFiltersFromUrl();
        performFilter();
      }

      function applyFiltersFromUrl() {
        const params = new URLSearchParams(window.location.search);
        const category = params.get('category')?.toLowerCase().trim() || '';
        const phase = params.get('phase')?.trim() || '';
        const query = params.get('q');
        if (query && searchInput) searchInput.value = query;

        const buttons = Array.from(tagFilterButtons ?? []) as HTMLElement[];
        function labelFor(type: string, value: string) {
          return buttons.find((btn) => btn.dataset.tagType === type && btn.dataset.tagValue === value)?.dataset.tagLabel || value;
        }

        if (category && ['offensive', 'defensive'].includes(category)) {
          activeFiltersSet.add(`category:${category}:${labelFor('category', category)}`);
        }
        if (phase) {
          if (!hasCategory('offensive')) {
            activeFiltersSet.add(`category:offensive:${labelFor('category', 'offensive')}`);
          }
          activeFiltersSet.add(`phase:${phase}:${labelFor('phase', phase)}`);
        }
      }

      if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', initSearch);
      else initSearch();
    })();
  </script>
</BaseLayout>
