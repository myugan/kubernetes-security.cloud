---
import BaseLayout from '../layouts/BaseLayout.astro';
import TacticIcon from '../components/TacticIcon.astro';
import { getCollection } from 'astro:content';
import { getAllMitreTechniques } from '../data/mitre-attack';
import { LANDING_TACTICS, pad2 } from '../lib/taxonomy';

const [glossary, topics] = await Promise.all([
  getCollection('glossary'),
  getCollection('topics'),
]);

const offensiveTopics = topics.filter((topic) => topic.data.category === 'offensive');
const techniqueById = new Map(getAllMitreTechniques().map((technique) => [technique.id, technique]));

const topicMap = new Map<string, number>();
for (const topic of offensiveTopics) {
  for (const id of topic.data.mitreTechniques ?? []) {
    topicMap.set(id, (topicMap.get(id) ?? 0) + 1);
  }
}

const mappedTechniqueIds = [...topicMap.keys()];
const totalMappings = [...topicMap.values()].reduce((sum, n) => sum + n, 0);

function tacticColumns(tacticField: string): string[] {
  return tacticField
    .split(/[,;]/)
    .map((part) => part.trim())
    .filter(Boolean);
}

const tactics = LANDING_TACTICS.map((name, index) => {
  const techs = mappedTechniqueIds
    .map((id) => techniqueById.get(id))
    .filter((technique): technique is NonNullable<typeof technique> => Boolean(technique))
    .filter((technique) => tacticColumns(technique.tactic).some((col) => col.toLowerCase() === name.toLowerCase()))
    .slice(0, 3)
    .map((technique) => technique.name);
  return {
    name,
    idx: pad2(index + 1),
    count: String(
      mappedTechniqueIds.filter((id) => {
        const technique = techniqueById.get(id);
        return technique && tacticColumns(technique.tactic).some((col) => col.toLowerCase() === name.toLowerCase());
      }).length
    ),
    techs,
  };
});
---

<BaseLayout
  title="Kubernetes Security Encyclopedia"
  description="A comprehensive reference for Kubernetes security concepts, topics, and best practices."
>
  <div class="max-w-7xl mx-auto px-7 lg:px-12">
    <section class="grid gap-14 py-16 lg:grid-cols-[1fr_300px] lg:gap-14 border-b border-app-border">
      <div class="flex flex-col gap-5 max-w-3xl">
        <p class="ks-kicker ks-kicker-accent">Encyclopedia</p>
        <h1 class="ks-display max-w-[22ch]">An encyclopedia of Kubernetes security</h1>
        <p class="ks-lede max-w-[56ch]">
          Terminology, attack patterns, defensive strategies, and tools.
        </p>
        <div class="flex flex-wrap gap-3 pt-1">
          <a href="/glossary" class="ks-btn ks-btn-primary">Browse the glossary</a>
          <a href="/techniques" class="ks-btn ks-btn-ghost">Open ATT&amp;CK map</a>
        </div>
      </div>
      <div class="ks-stat-grid self-start">
        <div class="ks-stat-cell">
          <div class="ks-stat-n">{glossary.length}</div>
          <div class="ks-stat-label">Glossary terms</div>
        </div>
        <div class="ks-stat-cell">
          <div class="ks-stat-n">{mappedTechniqueIds.length}</div>
          <div class="ks-stat-label">ATT&amp;CK techniques mapped</div>
        </div>
        <div class="ks-stat-cell">
          <div class="ks-stat-n">{totalMappings}</div>
          <div class="ks-stat-label">Technique to topic links</div>
        </div>
      </div>
    </section>

    <section class="py-11 pb-16">
      <div class="flex items-baseline justify-between gap-4 mb-5">
        <h2 class="text-[19px] font-semibold tracking-tight ds-text-primary">The chain, left to right</h2>
        <p class="font-mono text-xs ds-text-muted">
          {mappedTechniqueIds.length} techniques · {totalMappings} topic mappings
        </p>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-px bg-app-border border border-app-border rounded-md overflow-hidden">
        {tactics.map((tactic) => (
          <a href={`/techniques#tactic-${tactic.name.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`} class="bg-app-surface-muted/80 p-[17px] min-h-[150px] flex flex-col gap-3 hover:bg-app-surface">
            <div class="flex items-center gap-2">
              <TacticIcon tactic={tactic.name} class="h-4 w-4 text-app-link" />
              <span class="font-mono text-[10.5px] ds-text-muted">{tactic.idx}</span>
              <span class="ml-auto font-mono text-[10.5px] text-app-link">{tactic.count}</span>
            </div>
            <div class="text-[15px] font-semibold leading-tight tracking-tight ds-text-primary">{tactic.name}</div>
            <div class="mt-auto flex flex-col gap-1.5">
              {tactic.techs.length === 0 ? (
                <div class="text-[12.5px] leading-snug ds-text-muted">No mapped techniques yet</div>
              ) : (
                tactic.techs.map((tech) => (
                  <div class="text-[12.5px] leading-snug ds-text-secondary border-l-[1.5px] border-app-link pl-2.5">{tech}</div>
                ))
              )}
            </div>
          </a>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>
