---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import TacticIcon from '../components/TacticIcon.astro';
import { getAllMitreTechniques } from '../data/mitre-attack';
import { LANDING_TACTICS, pad2 } from '../lib/taxonomy';

const topics = await getCollection('topics');
const offensiveTopics = topics.filter((t) => t.data.category === 'offensive');
const allTechniques = getAllMitreTechniques();
const techniqueById = new Map(allTechniques.map((technique) => [technique.id, technique]));

type MappedTopic = {
  slug: string;
  title: string;
  description: string;
  category: string;
  phase?: string;
};

const topicMap = new Map<string, MappedTopic[]>();
for (const topic of offensiveTopics) {
  for (const id of topic.data.mitreTechniques ?? []) {
    const list = topicMap.get(id) ?? [];
    list.push({
      slug: topic.slug,
      title: topic.data.title,
      description: topic.data.description,
      category: topic.data.category,
      phase: topic.data.phase ?? topic.data.offensiveType,
    });
    topicMap.set(id, list);
  }
}

const mappedTechniqueIds = [...topicMap.keys()].sort();
const techniques = mappedTechniqueIds.map((id) => {
  const known = techniqueById.get(id);
  if (known) return known;
  return {
    id,
    name: `Technique ${id}`,
    tactic: 'Uncategorized',
    description: 'Mapped from topics; add to local MITRE technique catalog for full metadata.',
    url: `https://attack.mitre.org/techniques/${id}`,
  };
});

const totalMappedTechniques = techniques.length;
const totalMappings = Array.from(topicMap.values()).reduce((sum, items) => sum + items.length, 0);

const MATRIX_TACTICS = [
  ...LANDING_TACTICS,
  'Collection',
  'Command and Control',
  'Exfiltration',
  'Reconnaissance',
] as const;

type MatrixCell = {
  id: string;
  name: string;
  url: string;
  description: string;
  tactic: string;
  topics: MappedTopic[];
};

function tacticColumnsForField(tacticField: string): Set<string> {
  const parts = tacticField.split(/[,;]/).map((s) => s.trim()).filter(Boolean);
  const cols = new Set<string>();
  for (const p of parts) {
    const hit = MATRIX_TACTICS.find((c) => c.toLowerCase() === p.toLowerCase());
    if (hit) cols.add(hit);
  }
  return cols;
}

const matrixByTactic = new Map<string, MatrixCell[]>();

for (const technique of techniques) {
  const topicsFor = topicMap.get(technique.id) ?? [];
  const cell: MatrixCell = {
    id: technique.id,
    name: technique.name,
    url: technique.url,
    description: technique.description,
    tactic: technique.tactic,
    topics: topicsFor,
  };
  const cols = tacticColumnsForField(technique.tactic);
  if (cols.size === 0) {
    const list = matrixByTactic.get('Other') ?? [];
    if (!list.some((c) => c.id === technique.id)) list.push(cell);
    matrixByTactic.set('Other', list);
    continue;
  }
  for (const col of cols) {
    const list = matrixByTactic.get(col) ?? [];
    if (!list.some((c) => c.id === technique.id)) list.push(cell);
    matrixByTactic.set(col, list);
  }
}

const matrixColumns = [
  ...MATRIX_TACTICS.filter((t) => (matrixByTactic.get(t)?.length ?? 0) > 0),
  ...((matrixByTactic.get('Other')?.length ?? 0) > 0 ? (['Other'] as const) : []),
];

function tacticAnchorId(tactic: string): string {
  const slug = tactic
    .toLowerCase()
    .normalize('NFKD')
    .replace(/[\u0300-\u036f]/g, '')
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-+|-+$/g, '');
  return `tactic-${slug || 'section'}`;
}

const matrixPayload = Object.fromEntries(
  techniques.map((technique) => [
    technique.id,
    {
      id: technique.id,
      name: technique.name,
      url: technique.url,
      description: technique.description,
      tactic: technique.tactic,
      topics: topicMap.get(technique.id) ?? [],
    },
  ])
);
---

<BaseLayout
  title="ATT&CK Map - Kubernetes Security"
  description="MITRE ATT&CK techniques mapped to offensive Kubernetes security topics, grouped by tactic with topic links."
>
  <div class="max-w-7xl mx-auto min-w-0 px-4 sm:px-7 lg:px-12 py-12">
    <div class="mb-8 grid gap-10 lg:grid-cols-[1fr_420px] lg:items-end border-b border-app-border pb-8">
      <div class="flex flex-col gap-3.5">
        <p class="ks-kicker ks-kicker-attack">ATT&amp;CK Map</p>
        <h1 class="ks-display">ATT&amp;CK Map</h1>
        <p class="ks-lede max-w-[min(56ch,calc(100vw-2rem))]">
          One page that visualizes all MITRE ATT&amp;CK techniques and where they are covered across topics.
          See also the
          <a href="https://kubernetes-threat-matrix.redguard.ch/" class="ds-link" target="_blank" rel="noopener noreferrer">Kubernetes Threat Matrix</a>.
        </p>
      </div>
      <div class="ks-stat-grid grid-cols-1 sm:grid-cols-3">
        <div class="ks-stat-cell">
          <span class="ks-stat-n">{allTechniques.length}</span>
          <span class="ks-stat-label">Catalog techniques</span>
        </div>
        <div class="ks-stat-cell">
          <span class="ks-stat-n">{totalMappedTechniques}</span>
          <span class="ks-stat-label">Mapped techniques</span>
        </div>
        <div class="ks-stat-cell">
          <span class="ks-stat-n">{totalMappings}</span>
          <span class="ks-stat-label">Topic mappings</span>
        </div>
      </div>
    </div>

    {matrixColumns.length === 0 ? (
      <div class="ks-card px-4 py-10 text-center">
        <p class="text-sm ds-text-secondary">No mapped techniques on offensive topics yet.</p>
      </div>
    ) : (
      <>
        <div class="ks-matrix-legend -mx-4 sm:-mx-7 lg:-mx-12 px-4 sm:px-7 lg:px-12">
          <span class="ks-kicker">Tactics</span>
          <span class="font-mono text-[11.5px] ds-text-primary">{matrixColumns.length}</span>
          <span class="w-px h-[18px] bg-app-border" aria-hidden="true"></span>
          <span class="inline-flex items-center gap-1.5 text-xs ds-text-muted">
            <span class="ks-matrix-swatch bg-offensive-bg border border-offensive-border"></span>
            Mapped to topics
          </span>
          <span class="inline-flex items-center gap-1.5 text-xs ds-text-muted">
            <span class="ks-matrix-swatch bg-offensive"></span>
            Selected
          </span>
          <span class="ml-auto font-mono text-[11px] ds-text-muted">Phase order →</span>
        </div>

        <div class="overflow-x-auto py-6">
          <div class="grid gap-2 items-start" style={`grid-template-columns: repeat(${matrixColumns.length}, minmax(118px, 1fr)); min-width: ${matrixColumns.length * 128}px`}>
            {matrixColumns.map((tactic, index) => {
              const cells = matrixByTactic.get(tactic) ?? [];
              return (
                <div id={tacticAnchorId(tactic)} class="flex flex-col gap-2 scroll-mt-24">
                  <div class="flex flex-col gap-1.5 pb-2 border-b border-app-border min-h-[58px]">
                    <div class="flex items-center gap-1.5">
                      <TacticIcon tactic={tactic} class="h-3.5 w-3.5 text-offensive" />
                      <span class="font-mono text-[9.5px] ds-text-muted">{pad2(index + 1)}</span>
                      <span class="ml-auto font-mono text-[9.5px] ds-text-muted">{cells.length}</span>
                    </div>
                    <span class="text-xs font-semibold leading-tight tracking-tight ds-text-primary">{tactic}</span>
                  </div>
                  {cells.map((cell) => (
                    <button
                      type="button"
                      class="ks-matrix-cell"
                      data-technique-id={cell.id}
                      aria-pressed="false"
                    >
                      <span class="id">{cell.id}</span>
                      <span class="name">{cell.name}</span>
                    </button>
                  ))}
                </div>
              );
            })}
          </div>
        </div>
      </>
    )}
  </div>

  <div id="matrix-detail" class="ks-matrix-detail">
    <div id="matrix-placeholder" class="max-w-7xl mx-auto px-4 sm:px-7 lg:px-12">
      <p class="ks-kicker mb-2">Selected technique</p>
      <p class="text-sm ds-text-muted max-w-[min(52ch,calc(100vw-2rem))]">Select a technique on the map to see its description and the topics that cover it.</p>
    </div>
    <div id="matrix-detail-body" class="hidden max-w-7xl mx-auto px-4 sm:px-7 lg:px-12 grid gap-10 lg:grid-cols-[340px_1fr] lg:gap-11 items-start">
      <div class="flex flex-col gap-3">
        <p class="ks-kicker">Selected technique</p>
        <div class="flex items-baseline gap-2.5 flex-wrap">
          <span id="detail-id" class="font-mono text-[15px] font-semibold text-offensive"></span>
          <h2 id="detail-name" class="m-0 text-2xl font-semibold tracking-tight leading-tight ds-text-primary"></h2>
        </div>
        <p id="detail-meta" class="text-[12.5px] ds-text-muted"></p>
        <p id="detail-desc" class="text-sm leading-relaxed ds-text-secondary"></p>
        <a id="detail-mitre" href="https://attack.mitre.org/" class="ks-btn ks-btn-primary self-start text-[12.5px] !px-3.5 !py-2" hidden target="_blank" rel="noopener noreferrer">
          Open on MITRE ↗
        </a>
      </div>
      <div class="flex flex-col gap-2.5">
        <p class="ks-kicker">Covered by</p>
        <div id="detail-topics" class="grid sm:grid-cols-2 lg:grid-cols-3 gap-2.5"></div>
      </div>
    </div>
  </div>
</BaseLayout>

<script define:vars={{ matrixPayload }}>
  const payload = matrixPayload;
  const placeholder = document.getElementById('matrix-placeholder');
  const detailBody = document.getElementById('matrix-detail-body');
  const idEl = document.getElementById('detail-id');
  const nameEl = document.getElementById('detail-name');
  const metaEl = document.getElementById('detail-meta');
  const descEl = document.getElementById('detail-desc');
  const mitreEl = document.getElementById('detail-mitre');
  const topicsEl = document.getElementById('detail-topics');
  const cells = document.querySelectorAll('[data-technique-id]');

  function escapeHtml(value) {
    return String(value)
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;');
  }

  function selectTechnique(id) {
    const data = payload[id];
    if (!data) return;
    cells.forEach((cell) => {
      const selected = cell.getAttribute('data-technique-id') === id;
      cell.classList.toggle('is-selected', selected);
      cell.setAttribute('aria-pressed', selected ? 'true' : 'false');
    });
    placeholder?.classList.add('hidden');
    detailBody?.classList.remove('hidden');
    if (idEl) idEl.textContent = data.id;
    if (nameEl) nameEl.textContent = data.name;
    if (metaEl) metaEl.textContent = `${data.tactic.split(',')[0].trim()} / ${data.topics.length} topic${data.topics.length === 1 ? '' : 's'} mapped`;
    if (descEl) descEl.textContent = data.description;
    if (mitreEl) {
      mitreEl.setAttribute('href', data.url);
      mitreEl.hidden = false;
    }
    if (topicsEl) {
      topicsEl.innerHTML = data.topics
        .map((topic) => {
          const phase = topic.phase ? ` · ${String(topic.phase).replace(/-/g, ' ').toUpperCase()}` : '';
          return `<a href="/topics/${escapeHtml(topic.slug)}" class="ks-card p-3.5 flex flex-col gap-1.5 border-offensive-border"><span class="ks-stance ks-stance-offensive">${escapeHtml(topic.category.toUpperCase())}${escapeHtml(phase)}</span><span class="text-sm font-semibold leading-snug ds-text-primary">${escapeHtml(topic.title)}</span><span class="text-xs leading-snug ds-text-muted">${escapeHtml(topic.description)}</span></a>`;
        })
        .join('');
    }
  }

  cells.forEach((cell) => {
    cell.addEventListener('click', () => selectTechnique(cell.getAttribute('data-technique-id')));
  });

  const hash = window.location.hash.replace(/^#/, '');
  if (hash && payload[hash]) selectTechnique(hash);
</script>
