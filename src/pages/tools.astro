---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getAllTools, getToolTypes } from '../data/tools';
import type { ToolType } from '../types';
import type { ToolDefinition } from '../data/tools';

const allTools = getAllTools().sort((a, b) => a.name.localeCompare(b.name));

const toolsByType: Record<string, ToolDefinition[]> = {
  offensive: [],
  defensive: [],
  audit: [],
  compliance: [],
};

allTools.forEach((tool) => {
  getToolTypes(tool).forEach((type) => {
    if (toolsByType[type] && !toolsByType[type].some((t) => t.name === tool.name)) {
      toolsByType[type].push(tool);
    }
  });
});

const categories: { key: ToolType; label: string; description: string }[] = [
  { key: 'offensive', label: 'Offensive', description: 'Penetration testing and security assessments' },
  { key: 'defensive', label: 'Defensive', description: 'Protecting and securing Kubernetes clusters' },
  { key: 'audit', label: 'Audit', description: 'Security auditing and vulnerability scanning' },
  { key: 'compliance', label: 'Compliance', description: 'Policy enforcement and best-practice validation' },
];
---

<BaseLayout
  title="Tools - Kubernetes Security"
  description="Curated Kubernetes security tools for offensive testing, defense, auditing, and compliance — with links and categories."
>
  <div class="border-b border-app-border">
    <div class="max-w-7xl mx-auto px-7 lg:px-12 py-12 lg:py-14 grid gap-10 lg:grid-cols-[1fr_420px] lg:items-end">
      <div class="flex flex-col gap-3.5">
        <p class="ks-kicker ks-kicker-accent">Tools</p>
        <h1 class="ks-display">Tools</h1>
        <p class="ks-lede max-w-[54ch]">
          Scanners, policy engines and runtime agents, with what each is actually good at.
        </p>
      </div>
      <div class="ks-stat-grid" style="grid-template-columns: repeat(2, 1fr);">
        <div class="ks-stat-cell">
          <span class="ks-stat-n">{allTools.length}</span>
          <span class="ks-stat-label">Tools</span>
        </div>
        <div class="ks-stat-cell">
          <span class="ks-stat-n">{categories.filter((cat) => (toolsByType[cat.key]?.length || 0) > 0).length}</span>
          <span class="ks-stat-label">Categories</span>
        </div>
      </div>
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-7 lg:px-12 py-10 lg:py-12">
    <div class="flex flex-wrap gap-1.5 mb-10">
      {categories.map((cat) => {
        const count = toolsByType[cat.key]?.length || 0;
        if (count === 0) return null;
        return (
          <a href={`#${cat.key}`} class="ks-facet">
            <span>{cat.label}</span>
            <span class="font-mono text-[11px] ds-text-muted">{count}</span>
          </a>
        );
      })}
    </div>

    <div class="flex flex-col gap-12">
      {categories.map((cat) => {
        const tools = toolsByType[cat.key] || [];
        if (tools.length === 0) return null;
        return (
          <section id={cat.key} class="scroll-mt-24">
            <div class="flex items-baseline justify-between gap-4 mb-4">
              <div>
                <h2 class="text-[19px] font-semibold tracking-tight ds-text-primary">{cat.label}</h2>
                <p class="text-sm ds-text-muted mt-0.5">{cat.description}</p>
              </div>
              <span class="font-mono text-xs ds-text-muted">{tools.length}</span>
            </div>
            <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-3">
              {tools.map((tool) => (
                <a href={tool.url} target="_blank" rel="noopener noreferrer" class="ks-card p-4 flex flex-col gap-1.5 group">
                  <div class="flex items-start justify-between gap-3">
                    <h3 class="text-[14.5px] font-semibold tracking-tight ds-text-primary group-hover:text-app-link">{tool.name}</h3>
                    <span class="font-mono text-[11px] ds-text-muted shrink-0">↗</span>
                  </div>
                  {tool.description && <p class="text-[12.5px] leading-snug ds-text-muted line-clamp-2">{tool.description}</p>}
                </a>
              ))}
            </div>
          </section>
        );
      })}
    </div>

    {allTools.length === 0 && (
      <div class="ks-card p-12 text-center">
        <p class="ds-text-muted">No tools have been added yet.</p>
      </div>
    )}
  </div>
</BaseLayout>
