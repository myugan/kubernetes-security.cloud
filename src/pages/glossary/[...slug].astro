---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import MitreTechniquesList from '../../components/MitreTechniquesList.astro';
import TypeDot from '../../components/TypeDot.astro';
import MetaPanel from '../../components/MetaPanel.astro';
import StanceBadge from '../../components/StanceBadge.astro';
import { getTools, getToolTypes } from '../../data/tools';
import { getToolTypeColors } from '../../utils/colors';
import { glossaryTypeLabel, formatPhaseUpper } from '../../lib/taxonomy';
import { topicsForGlossaryTerm } from '../../lib/related';

export async function getStaticPaths() {
  const glossaryEntries = await getCollection('glossary');
  const sorted = glossaryEntries.sort((a, b) => a.data.title.localeCompare(b.data.title));
  return sorted.map((entry, index) => ({
    params: { slug: entry.slug },
    props: {
      entry,
      prev: index > 0 ? sorted[index - 1] : null,
      next: index < sorted.length - 1 ? sorted[index + 1] : null,
    },
  }));
}

const { entry, prev, next } = Astro.props;
const { Content } = await entry.render();
const toolsList = entry.data.tools ? getTools(entry.data.tools) : [];
const allGlossaryEntries = await getCollection('glossary');
const allTopics = await getCollection('topics');
const relatedTopics = topicsForGlossaryTerm(entry, allTopics);

function findGlossaryEntryByTitle(title: string) {
  const normalizedTitle = title.toLowerCase().trim();
  return allGlossaryEntries.find((item) => item.data.title.toLowerCase().trim() === normalizedTitle);
}

const relatedTerms = (entry.data.relatedTerms ?? [])
  .map((term) => {
    const related = findGlossaryEntryByTitle(term);
    return related
      ? { title: term, description: related.data.description, category: related.data.category, href: `/glossary/${related.slug}` }
      : { title: term, description: '', category: '', href: '' };
  });

const typeLabel = glossaryTypeLabel(entry.data.category);
const metaRows = [
  { label: 'Kind', value: entry.data.title, mono: true },
  { label: 'Type', value: typeLabel },
  { label: 'Referenced by', value: `${relatedTopics.length} topic${relatedTopics.length === 1 ? '' : 's'}` },
].concat(
  entry.data.kubernetesVersion
    ? [{ label: 'Kubernetes', value: Array.isArray(entry.data.kubernetesVersion) ? entry.data.kubernetesVersion.join(', ') : entry.data.kubernetesVersion, mono: true }]
    : []
);
---

<BaseLayout
  title={`${entry.data.title} - Glossary`}
  description={entry.data.description}
  ogType="article"
  section={entry.data.category}
  markdownUrl={`/glossary/${entry.slug}.md`}
>
  <div class="border-b border-app-border bg-app-surface-muted/60">
    <div class="max-w-7xl mx-auto px-4 sm:px-7 lg:px-12 py-2.5 flex items-center justify-between gap-4">
      <nav class="ks-crumb" aria-label="Breadcrumb">
        <a href="/glossary">Glossary</a>
        <span class="ks-crumb-sep">/</span>
        <span>{typeLabel.charAt(0) + typeLabel.slice(1).toLowerCase()}</span>
        <span class="ks-crumb-sep">/</span>
        <span class="ds-text-primary">{entry.data.title}</span>
      </nav>
      <div class="hidden sm:flex items-center gap-3.5 text-xs ds-text-muted">
        {prev ? <a href={`/glossary/${prev.slug}`} class="hover:text-app-text-primary">← {prev.data.title}</a> : <span />}
        <span class="text-app-border-strong">|</span>
        {next ? <a href={`/glossary/${next.slug}`} class="hover:text-app-text-primary">{next.data.title} →</a> : <span />}
      </div>
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-7 lg:px-12">
    <header class="grid gap-10 py-8 lg:grid-cols-[1fr_300px] lg:items-start border-b border-app-border">
      <div class="flex flex-col gap-3">
        <div class="flex items-center gap-2.5">
          <TypeDot category={entry.data.category} />
          <h1 class="text-[32px] leading-none font-semibold tracking-tight ds-text-primary">{entry.data.title}</h1>
          <span class="font-mono text-[9.5px] tracking-widest ds-text-muted pt-1">{typeLabel}</span>
        </div>
        <p class="text-[17px] leading-relaxed ds-text-secondary max-w-[min(60ch,calc(100vw-2rem))]">{entry.data.description}</p>
      </div>
      <MetaPanel rows={metaRows} />
    </header>

    <div class="grid lg:grid-cols-[1fr_380px]">
      <div class="lg:border-r border-app-border py-6 lg:pr-8">
        <div class="prose prose-slate dark:prose-invert max-w-none mb-8">
          <Content />
        </div>

        <div class="flex items-baseline justify-between mb-3">
          <p class="ks-kicker">Attacked and defended in</p>
          <span class="font-mono text-[10.5px] ds-text-muted">{relatedTopics.length}</span>
        </div>
        {relatedTopics.length === 0 ? (
          <p class="text-sm ds-text-muted">No topics reference this term yet.</p>
        ) : (
          <div class="ks-card overflow-hidden">
            {relatedTopics.map((topic) => {
              const phase = formatPhaseUpper(topic.data.phase ?? topic.data.offensiveType);
              return (
                <a href={`/topics/${topic.slug}`} class="flex items-center gap-3 px-3.5 py-2.5 border-b border-app-border last:border-0 hover:bg-app-surface-muted/70">
                  <StanceBadge stance={topic.data.category} />
                  <span class="text-[13.5px] font-medium leading-snug ds-text-primary">{topic.data.title}</span>
                  {phase && <span class="ml-auto font-mono text-[10px] tracking-wider ds-text-muted whitespace-nowrap">{phase}</span>}
                </a>
              );
            })}
          </div>
        )}

        {toolsList.length > 0 && (
          <div class="mt-8">
            <div class="flex items-baseline justify-between mb-3">
              <p class="ks-kicker">Tools</p>
              <a href="/tools" class="text-sm ds-link">View all tools</a>
            </div>
            <ul class="space-y-2">
              {toolsList.map((tool) => (
                <li class="flex items-center gap-2 flex-wrap">
                  <a href={tool.url} target="_blank" rel="noopener noreferrer" class="ds-link text-sm">{tool.name}</a>
                  {getToolTypes(tool).map((type) => {
                    const colors = getToolTypeColors(type);
                    return <span class={`px-2 py-0.5 text-xs font-medium rounded border ${colors.bg} ${colors.text} ${colors.border}`}>{type}</span>;
                  })}
                </li>
              ))}
            </ul>
          </div>
        )}

        {entry.data.mitreTechniques && entry.data.mitreTechniques.length > 0 && (
          <div class="mt-8">
            <MitreTechniquesList techniqueIds={entry.data.mitreTechniques} />
          </div>
        )}
      </div>

      <aside class="py-6 lg:pl-8">
        <div class="flex items-baseline justify-between mb-3">
          <p class="ks-kicker">Related terms</p>
          <span class="font-mono text-[10.5px] ds-text-muted">{relatedTerms.length}</span>
        </div>
        {relatedTerms.length === 0 ? (
          <p class="text-sm ds-text-muted">No related terms listed.</p>
        ) : (
          <div class="flex flex-col gap-2">
            {relatedTerms.map((term) =>
              term.href ? (
                <a href={term.href} class="ks-card p-3 flex flex-col gap-1">
                  <div class="flex items-center gap-1.5">
                    <TypeDot category={term.category} size="sm" />
                    <span class="text-[13.5px] font-semibold tracking-tight">{term.title}</span>
                    <span class="font-mono text-[9px] tracking-widest ds-text-muted">{glossaryTypeLabel(term.category)}</span>
                  </div>
                  <span class="text-xs leading-snug ds-text-secondary">{term.description}</span>
                </a>
              ) : (
                <div class="ks-card p-3 text-[13.5px] ds-text-muted">{term.title}</div>
              )
            )}
          </div>
        )}
      </aside>
    </div>
  </div>
</BaseLayout>
