---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { features } from '../config/features';
import StanceBadge from '../components/StanceBadge.astro';
import { STEP_TYPE_BORDER, type AttackStepType } from '../components/attack-path-cytoscape-theme';

if (!features.attackPaths) {
  return Astro.redirect('/glossary');
}

const attackPaths = await getCollection('attack-paths');
const sortedPaths = attackPaths.sort((a, b) => a.data.title.localeCompare(b.data.title));
---

<BaseLayout
  title="Attack Paths - Kubernetes Security"
  description="Visual step-by-step attack path diagrams for Kubernetes: how breaches chain from initial access to impact."
>
  <div class="border-b border-app-border">
    <div class="max-w-7xl mx-auto px-4 sm:px-7 lg:px-12 py-12 lg:py-14 grid gap-10 lg:grid-cols-[1fr_300px] lg:items-end">
      <div class="flex flex-col gap-3.5">
        <p class="ks-kicker ks-kicker-attack">Attack Paths</p>
        <h1 class="ks-display">Attack paths</h1>
        <p class="ks-lede max-w-[min(54ch,calc(100vw-2rem))]">
          Interactive maps that show how attackers chain steps from initial access to cluster-wide impact in Kubernetes.
        </p>
      </div>
      <div class="ks-stat-grid" style="grid-template-columns: 1fr;">
        <div class="ks-stat-cell">
          <span class="ks-stat-n">{sortedPaths.length}</span>
          <span class="ks-stat-label">Documented paths</span>
        </div>
      </div>
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-7 lg:px-12 py-10 lg:py-12">
    <ul class="grid gap-3 sm:grid-cols-2" role="list">
      {sortedPaths.map((path) => {
        const firstType = (path.data.steps[0]?.type ?? 'initial') as AttackStepType;
        const lastType = (path.data.steps[path.data.steps.length - 1]?.type ?? 'exfiltration') as AttackStepType;
        const startAccent = STEP_TYPE_BORDER[firstType];
        const endAccent = STEP_TYPE_BORDER[lastType];
        const versions = typeof path.data.kubernetesVersion === 'string'
          ? [path.data.kubernetesVersion]
          : path.data.kubernetesVersion ?? [];
        return (
          <li>
            <a href={`/attack-paths/${path.id}`} class="ks-card p-5 flex flex-col gap-3 h-full group">
              <div class="flex items-center gap-2 flex-wrap">
                <StanceBadge stance={path.data.category} />
                {versions.map((version) => (
                  <span class="font-mono text-[10.5px] ds-text-muted">{version}</span>
                ))}
              </div>
              <h2 class="text-[17px] font-semibold tracking-tight leading-snug ds-text-primary group-hover:text-app-link">
                {path.data.title}
              </h2>
              <p class="text-[13px] leading-relaxed ds-text-muted line-clamp-3 flex-1">{path.data.description}</p>
              <div
                class="attack-path-flow flex items-center gap-1"
                aria-hidden="true"
                style={`--flow-start: ${startAccent.light}; --flow-end: ${endAccent.light}; --flow-start-dark: ${startAccent.dark}; --flow-end-dark: ${endAccent.dark};`}
              >
                {path.data.steps.map((step, i) => {
                  const t = step.type as AttackStepType;
                  const c = STEP_TYPE_BORDER[t] ?? STEP_TYPE_BORDER.lateral;
                  return (
                    <span class="inline-flex items-center gap-1">
                      {i > 0 && <span class="attack-path-flow-arrow ds-text-muted">→</span>}
                      <span class="attack-path-flow-dot h-2.5 w-2.5 rounded-full shrink-0" style={`--dot: ${c.light}; --dot-dark: ${c.dark};`} title={step.type} />
                    </span>
                  );
                })}
              </div>
              <div class="flex items-center justify-between text-[12.5px]">
                <span class="ds-text-muted"><span class="font-mono ds-text-primary">{path.data.steps.length}</span> steps</span>
                <span class="ds-link">View map →</span>
              </div>
            </a>
          </li>
        );
      })}
    </ul>
  </div>
</BaseLayout>

<style>
  .attack-path-flow-dot {
    background-color: var(--dot);
    box-shadow: 0 0 0 2px rgb(var(--ks-surface, 255 255 255)), 0 0 0 3px var(--dot);
  }
  :global(.dark) .attack-path-flow-dot {
    background-color: var(--dot-dark);
    box-shadow: 0 0 0 2px rgb(var(--ks-surface, 24 24 27)), 0 0 0 3px var(--dot-dark);
  }
  .attack-path-flow-arrow {
    font-size: 10px;
    opacity: 0.5;
  }
</style>
