---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import ArticleContents from '../../components/ArticleContents.astro';
import MetaPanel from '../../components/MetaPanel.astro';
import MitreTechnique from '../../components/MitreTechnique.astro';
import { getMitreTechnique } from '../../data/mitre-attack';
import { getTools, getToolTypes } from '../../data/tools';
import { getToolTypeColors } from '../../utils/colors';
import { formatPhase, pad2 } from '../../lib/taxonomy';
import { glossaryTermsForTopic, relatedTopics } from '../../lib/related';
import { TOPIC_OG_HEIGHT, TOPIC_OG_WIDTH } from '../../config/topic-og';

export async function getStaticPaths() {
  const topics = await getCollection('topics');
  return topics.map((topic) => ({
    params: { slug: topic.slug },
    props: { topic },
  }));
}

const { topic } = Astro.props;
const { Content, headings } = await topic.render();
const tocHeadings = (headings ?? []).filter((heading) => heading.depth === 2);

const wordsPerMinute = 220;
const markdownWordCount = topic.body.trim().split(/\s+/).filter(Boolean).length;
const estimatedReadMinutes = Math.max(1, Math.ceil(markdownWordCount / wordsPerMinute));
const publishedTime = topic.data.createdAt ? topic.data.createdAt.toISOString() : undefined;
const createdAtLabel = topic.data.createdAt
  ? new Intl.DateTimeFormat('en-US', { year: 'numeric', month: 'short', day: 'numeric' }).format(topic.data.createdAt)
  : 'Not specified';

const toolsList = topic.data.tools ? getTools(topic.data.tools) : [];
const [allTopics, allTerms] = await Promise.all([getCollection('topics'), getCollection('glossary')]);
const nextTopics = relatedTopics(topic, allTopics, 2);
const usedTerms = glossaryTermsForTopic(topic, allTerms).slice(0, 8);

const phase = topic.data.phase ?? topic.data.offensiveType;
const phaseLabel = formatPhase(phase);
const category = topic.data.category;
const stance = category === 'offensive' || category === 'defensive' ? category : 'neutral';
const stanceLabel = category.charAt(0).toUpperCase() + category.slice(1);

const mitreIds = topic.data.mitreTechniques ?? [];
const mitreChips = mitreIds.map((id) => {
  const known = getMitreTechnique(id);
  return {
    id,
    name: known?.name ?? id,
    url: known?.url ?? `https://attack.mitre.org/techniques/${id}`,
  };
});

const metaRows = [
  { label: 'Last updated', value: createdAtLabel, mono: true },
];

const contents = [
  ...tocHeadings.map((heading) => ({ slug: heading.slug, text: heading.text })),
  { slug: 'impact-and-mitigation', text: 'Impact and Mitigation' },
  ...((nextTopics.length > 0 || usedTerms.length > 0) ? [{ slug: 'where-to-go-next', text: 'Where to go next' }] : []),
];

function nextKicker(otherCategory: string): { label: string; kind: 'offensive' | 'defensive' | 'neutral' } {
  if (stance === 'defensive' && otherCategory === 'offensive') {
    return { label: 'Detects · Offensive', kind: 'offensive' };
  }
  if (stance === 'offensive' && otherCategory === 'defensive') {
    return { label: 'Detected by · Defensive', kind: 'defensive' };
  }
  if (otherCategory === 'offensive') return { label: 'Related · Offensive', kind: 'offensive' };
  if (otherCategory === 'defensive') return { label: 'Related · Defensive', kind: 'defensive' };
  return { label: 'Related', kind: 'neutral' };
}

function inlineMarkdownToHtml(text: string): string {
  return text
    .replace(/\[([^\]]+)\]\(([^)]+)\)/g, '<a href="$2" class="ds-link" target="_blank" rel="noopener noreferrer">$1</a>')
    .replace(/\*\*([^*]+)\*\*/g, '<strong class="font-semibold ds-text-primary">$1</strong>')
    .replace(/`([^`]+)`/g, '<code class="bg-app-code-bg border border-app-code-border text-app-code-text px-1 py-0.5 rounded text-xs font-mono break-words">$1</code>');
}

const impactItems = Array.isArray(topic.data.impact) ? topic.data.impact : [topic.data.impact];
const mitigationItems = Array.isArray(topic.data.mitigation) ? topic.data.mitigation : [topic.data.mitigation];

const referenceLinks: { text: string; href: string }[] = [];
if (topic.data.references) {
  const pattern = /\[([^\]]+)\]\(([^)]+)\)/g;
  let match: RegExpExecArray | null;
  while ((match = pattern.exec(topic.data.references)) !== null) {
    referenceLinks.push({ text: match[1], href: match[2] });
  }
}

const impactLinkParentClass =
  'ds-text-secondary text-[0.9375rem] leading-relaxed break-words text-pretty hyphens-auto [&_a]:text-app-link [&_a]:no-underline [&_a]:hover:underline';
---

<BaseLayout
  title={`${topic.data.title} - Topics`}
  description={topic.data.description}
  image={`/og/topics/${topic.slug}.png`}
  imageWidth={TOPIC_OG_WIDTH}
  imageHeight={TOPIC_OG_HEIGHT}
  imageAlt={`${topic.data.title} — Kubernetes security topic`}
  ogType="article"
  section={topic.data.category}
  publishedTime={publishedTime}
  modifiedTime={publishedTime}
>
  <div class:list={[stance === 'offensive' ? 'ks-banner-offensive' : stance === 'defensive' ? 'ks-banner-defensive' : 'bg-app-surface-muted/60 border-b border-app-border']}>
    <div class="max-w-7xl mx-auto px-7 lg:px-12 py-8 lg:py-[30px] flex flex-col gap-5">
      <nav class="ks-crumb" aria-label="Breadcrumb">
        <a href="/topics">Topics</a>
        <span class="ks-crumb-sep">/</span>
        <a href={`/topics?category=${encodeURIComponent(category)}`}>{stanceLabel}</a>
        {phaseLabel && typeof phase === 'string' && (
          <>
            <span class="ks-crumb-sep">/</span>
            <a href={`/topics?category=${encodeURIComponent(category)}&phase=${encodeURIComponent(phase)}`}>{phaseLabel}</a>
          </>
        )}
        <span class="ks-crumb-sep">/</span>
        <span class="ds-text-primary">{topic.data.title}</span>
      </nav>

      <div class="grid gap-10 lg:grid-cols-[1fr_300px] lg:items-end">
        <div class="flex flex-col gap-3.5">
          <h1 class="ks-display max-w-[20ch]">{topic.data.title}</h1>
          <p class="ks-lede max-w-[62ch]">{topic.data.description}</p>
          {mitreChips.length > 0 && (
            <div class="flex items-center gap-1.5 flex-wrap pt-1">
              <span class="ks-kicker mr-1">ATT&amp;CK</span>
              {mitreChips.map((chip) => (
                <MitreTechnique techniqueId={chip.id} />
              ))}
            </div>
          )}
        </div>
        <MetaPanel rows={metaRows} />
      </div>
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-7 lg:px-12">
    <ArticleContents items={contents} accent={stance} readMinutes={estimatedReadMinutes} />
  </div>

  <article class="max-w-7xl mx-auto px-7 lg:px-12">
    <div class="topic-article-prose prose prose-slate dark:prose-invert max-w-[860px] py-8 lg:py-9
      prose-h1:hidden
      prose-p:text-[16px] prose-p:leading-[1.7]
      prose-li:leading-relaxed
      prose-strong:font-semibold
      prose-a:text-app-link prose-a:font-medium hover:prose-a:underline
      prose-blockquote:border-l-4 prose-blockquote:border-app-link prose-blockquote:pl-4 prose-blockquote:italic">
      <Content />
    </div>
  </article>

  <section
    id="impact-and-mitigation"
    class:list={['ks-verdict scroll-mt-24', stance === 'offensive' ? 'ks-verdict-offensive' : stance === 'defensive' ? 'ks-verdict-defensive' : 'bg-app-surface-muted/50']}
  >
    <div class="max-w-7xl mx-auto px-7 lg:px-12 grid gap-10 lg:grid-cols-[1fr_1.25fr] lg:gap-14 items-start">
      <div class="flex flex-col gap-3">
        <p class="ks-kicker">Impact</p>
        <div class="flex flex-col gap-3">
          {impactItems.map((item) => (
            <p class="m-0 text-[17px] leading-relaxed ds-text-secondary text-pretty" set:html={inlineMarkdownToHtml(item)} />
          ))}
        </div>
      </div>
      <div class="flex flex-col gap-3.5">
        <p class="ks-kicker">Mitigation</p>
        {mitigationItems.length === 1 ? (
          <p class={impactLinkParentClass} set:html={inlineMarkdownToHtml(mitigationItems[0])} />
        ) : (
          <ol class="ks-mitigation-list">
            {mitigationItems.map((item, index) => (
              <li class="ks-mitigation-item">
                <span class="ks-mitigation-idx font-mono">{pad2(index + 1)}</span>
                <span class="ks-mitigation-text" set:html={inlineMarkdownToHtml(item)} />
              </li>
            ))}
          </ol>
        )}
      </div>
    </div>
  </section>

  {(nextTopics.length > 0 || usedTerms.length > 0 || toolsList.length > 0 || referenceLinks.length > 0) && (
    <div id="where-to-go-next" class="max-w-7xl mx-auto px-7 lg:px-12 py-9 lg:py-11 flex flex-col gap-4 scroll-mt-24">
      {(nextTopics.length > 0 || usedTerms.length > 0) && (
        <>
          <p class="ks-kicker">Where to go next</p>
          <div class="ks-next-grid">
            {nextTopics.map((other) => {
              const kicker = nextKicker(other.data.category);
              return (
                <a href={`/topics/${other.slug}`} class:list={['ks-next-card', `ks-next-card-${kicker.kind}`]}>
                  <span class="ks-next-kicker">{kicker.label}</span>
                  <span class="text-[14.5px] font-semibold leading-snug tracking-tight ds-text-primary">{other.data.title}</span>
                  <span class="text-[12.5px] leading-snug ds-text-muted">{other.data.description}</span>
                </a>
              );
            })}
            {usedTerms.length > 0 && (
              <div class="ks-next-card ks-next-card-neutral">
                <span class="ks-next-kicker">Terms used here</span>
                <div class="flex flex-wrap gap-1.5 pt-1">
                  {usedTerms.map((term) => (
                    <a href={`/glossary/${term.slug}`} class="ks-term-pill">{term.data.title}</a>
                  ))}
                </div>
              </div>
            )}
          </div>
        </>
      )}

      {toolsList.length > 0 && (
        <div class="flex flex-col gap-2.5 pt-2">
          <div class="flex items-baseline justify-between">
            <p class="ks-kicker">Tools</p>
            <a href="/tools" class="text-sm ds-link">View all tools</a>
          </div>
          <ul class="flex flex-wrap gap-x-5 gap-y-2">
            {toolsList.map((tool) => (
              <li class="flex items-center gap-2">
                <a href={tool.url} target="_blank" rel="noopener noreferrer" class="ds-link text-sm">{tool.name}</a>
                {getToolTypes(tool).map((type) => {
                  const colors = getToolTypeColors(type);
                  return <span class={`px-2 py-0.5 text-[10px] font-medium rounded border ${colors.bg} ${colors.text} ${colors.border}`}>{type}</span>;
                })}
              </li>
            ))}
          </ul>
        </div>
      )}

      {referenceLinks.length > 0 && (
        <div class="flex flex-col gap-2.5 pt-2">
          <p class="ks-kicker">References</p>
          <div class="flex gap-x-5 gap-y-2 flex-wrap">
            {referenceLinks.map((link) => (
              <a href={link.href} class="text-[13px] leading-snug ds-link" target="_blank" rel="noopener noreferrer">{link.text}</a>
            ))}
          </div>
        </div>
      )}
    </div>
  )}
</BaseLayout>
