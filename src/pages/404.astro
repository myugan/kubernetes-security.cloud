---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="404 - Page Not Found"
  description="This page could not be found on kubernetes-security.cloud. Browse the glossary or topics for Kubernetes security reference material."
>
  <div class="max-w-2xl mx-auto px-7 lg:px-12 py-24 lg:py-32">
    <p class="ks-kicker ks-kicker-accent mb-4">Error</p>
    <h1 class="ks-display mb-4">404</h1>
    <p class="ks-lede mb-8 max-w-[40ch]">This page is not in the encyclopedia. Try the glossary or topics instead.</p>
    <div class="flex flex-wrap gap-3">
      <a href="/glossary" class="ks-btn ks-btn-primary">Browse the glossary</a>
      <a href="/topics" class="ks-btn ks-btn-ghost">Open topics</a>
    </div>
  </div>
</BaseLayout>
