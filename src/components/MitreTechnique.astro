---
import { getMitreTechnique } from '../data/mitre-attack';

interface Props {
  techniqueId: string;
  showDescription?: boolean;
}

const { techniqueId, showDescription = false } = Astro.props;
const technique = getMitreTechnique(techniqueId);
---

{technique && (
  <div class="inline-flex items-center gap-2">
    <a
      href={technique.url}
      target="_blank"
      rel="noopener noreferrer"
      class="ks-mitre-chip"
      title={`MITRE ATT&CK ${technique.id}: ${technique.name}`}
    >
      <span class="id">{technique.id}</span>
      <span class="hidden sm:inline">{technique.name}</span>
    </a>
    {showDescription && (
      <span class="text-xs ds-text-muted hidden md:inline">{technique.description}</span>
    )}
  </div>
)}

{!technique && (
  <span class="ks-mitre-chip">
    <span class="id">{techniqueId}</span>
    <span class="ds-text-muted">(Unknown)</span>
  </span>
)}
