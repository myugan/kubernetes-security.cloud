---
interface TopicLink {
  slug: string;
  title: string;
}

interface Props {
  id: string;
  name: string;
  url: string;
  description: string;
  topics: TopicLink[];
}

const { id, name, url, description, topics } = Astro.props;
const topicCount = topics.length;
---

<details class="mitre-disclosure group w-full min-w-0 rounded-xl border border-app-border bg-app-surface shadow-sm transition-[border-color,box-shadow] hover:border-app-border-strong open:border-primary-300/80 open:shadow-md dark:open:border-primary-700/60">
  <summary class="mitre-disclosure-summary flex w-full cursor-pointer list-none items-start gap-3 px-4 py-3.5 text-left outline-none transition-colors hover:bg-app-surface-muted/50 focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-primary-500/40 sm:items-center sm:gap-4 sm:px-5 sm:py-4 [&::-webkit-details-marker]:hidden">
    <span class="mitre-id-badge shrink-0 font-mono text-xs font-bold tabular-nums" title="MITRE technique ID">
      {id}
    </span>
    <span class="min-w-0 flex-1">
      <span class="block text-sm font-semibold leading-snug text-pretty text-app-text-primary sm:text-base">
        {name}
      </span>
      <span class="mt-1 flex flex-wrap items-center gap-2 text-xs text-app-text-muted">
        {topicCount > 0 ? (
          <span class="mitre-meta-pill">
            {topicCount} topic{topicCount === 1 ? '' : 's'} on this site
          </span>
        ) : (
          <span class="mitre-meta-pill mitre-meta-pill-muted">No linked topics</span>
        )}
      </span>
    </span>
    <span
      class="mitre-chevron flex h-8 w-8 shrink-0 items-center justify-center rounded-lg border border-app-border bg-app-surface-muted/80 text-app-text-muted transition-transform duration-200 group-open:rotate-180 group-open:border-primary-200 group-open:bg-primary-50 group-open:text-primary-700 dark:group-open:border-primary-800 dark:group-open:bg-primary-950/40 dark:group-open:text-primary-300"
      aria-hidden="true"
    >
      <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
      </svg>
    </span>
  </summary>
  <div class="mitre-disclosure-panel border-t border-app-border">
    <div class="mitre-disclosure-inner space-y-4 px-4 py-4 sm:px-5 sm:py-5">
      <div class="rounded-lg border border-app-border/80 bg-app-surface-muted/40 p-4 dark:bg-zinc-900/40">
        <p class="mb-2 text-[10px] font-semibold uppercase tracking-wider text-app-text-muted">Description</p>
        <p class="text-sm leading-relaxed text-pretty text-app-text-secondary sm:text-[0.9375rem]">
          {description}
        </p>
      </div>
      <div class="flex flex-wrap gap-2">
        <a href={url} target="_blank" rel="noopener noreferrer" class="mitre-action-btn mitre-action-btn-primary">
          <svg class="h-4 w-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
          MITRE ATT&amp;CK
        </a>
      </div>
      {topicCount > 0 ? (
        <div>
          <p class="mb-2.5 text-[10px] font-semibold uppercase tracking-wider text-app-text-muted">
            Related topics on this site
          </p>
          <ul class="grid gap-2 sm:grid-cols-2">
            {topics.map((topic) => (
              <li>
                <a
                  href={`/topics/${topic.slug}`}
                  class="mitre-topic-link group/topic flex h-full min-h-[2.75rem] flex-col justify-center rounded-lg border border-app-border bg-app-surface px-3 py-2.5 transition hover:border-primary-300 hover:bg-primary-50/50 dark:hover:border-primary-700 dark:hover:bg-primary-950/30"
                >
                  <span class="text-sm font-medium leading-snug text-pretty text-app-text-primary group-hover/topic:text-primary-700 dark:group-hover/topic:text-primary-300">
                    {topic.title}
                  </span>
                  <span class="mt-1 text-[11px] text-app-text-muted">Read topic →</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      ) : (
        <p class="rounded-lg border border-dashed border-app-border px-3 py-2.5 text-xs text-app-text-muted">
          No offensive topics on this site reference this technique yet.
        </p>
      )}
    </div>
  </div>
</details>

<style>
  .mitre-id-badge {
    display: inline-flex;
    align-items: center;
    border-radius: 0.5rem;
    border: 1px solid rgb(var(--color-app-border) / 1);
    background: rgb(var(--color-app-surface-muted) / 0.7);
    padding: 0.375rem 0.625rem;
    color: rgb(var(--color-app-text-secondary) / 1);
    letter-spacing: 0.02em;
  }

  :global(.dark) .mitre-id-badge {
    border-color: rgb(63 63 70);
    background: rgb(39 39 42 / 0.8);
    color: rgb(212 212 216);
  }

  .mitre-meta-pill {
    display: inline-flex;
    align-items: center;
    border-radius: 9999px;
    background: rgb(239 246 255);
    padding: 0.125rem 0.5rem;
    font-weight: 500;
    color: rgb(29 78 216);
  }

  :global(.dark) .mitre-meta-pill {
    background: rgb(30 58 138 / 0.35);
    color: rgb(147 197 253);
  }

  .mitre-meta-pill-muted {
    background: rgb(var(--color-app-surface-muted) / 0.8);
    color: rgb(var(--color-app-text-muted) / 1);
  }

  :global(.dark) .mitre-meta-pill-muted {
    background: rgb(39 39 42 / 0.8);
    color: rgb(161 161 170);
  }

  .mitre-action-btn {
    display: inline-flex;
    min-height: 2.25rem;
    align-items: center;
    gap: 0.375rem;
    border-radius: 0.5rem;
    border: 1px solid transparent;
    padding: 0.375rem 0.75rem;
    font-size: 0.8125rem;
    font-weight: 600;
    outline: none;
    transition:
      background-color 0.15s,
      border-color 0.15s,
      color 0.15s;
  }

  .mitre-action-btn:focus-visible {
    box-shadow: 0 0 0 2px rgb(var(--color-app-surface) / 1), 0 0 0 4px rgb(59 130 246 / 0.45);
  }

  .mitre-action-btn-primary {
    border-color: rgb(191 219 254);
    background: rgb(239 246 255);
    color: rgb(29 78 216);
  }

  .mitre-action-btn-primary:hover {
    background: rgb(219 234 254);
    color: rgb(30 64 175);
  }

  :global(.dark) .mitre-action-btn-primary {
    border-color: rgb(30 58 138 / 0.6);
    background: rgb(30 58 138 / 0.25);
    color: rgb(147 197 253);
  }

  :global(.dark) .mitre-action-btn-primary:hover {
    background: rgb(30 58 138 / 0.4);
    color: rgb(191 219 254);
  }

  .mitre-disclosure-panel {
    animation: mitre-panel-in 0.2s ease-out;
  }

  @keyframes mitre-panel-in {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
